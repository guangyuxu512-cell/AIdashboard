{
  "name": "ecommerce-ai-control-center",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "dev:frontend": "pnpm --filter @control-center/frontend dev",
    "dev:mobile": "pnpm --filter @control-center/mobile dev",
    "dev:electron": "pnpm --filter @control-center/electron dev",
    "dev:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "dev:down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-status.ps1",
    "build:frontend": "pnpm --filter @control-center/frontend build",
    "build:mobile": "pnpm --filter @control-center/mobile build",
    "build:electron": "pnpm --filter @control-center/electron build"
  }
}
