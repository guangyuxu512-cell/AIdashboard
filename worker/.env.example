WORKER_SERVER_URL=https://control-center.example.com
WORKER_DEVICE_ID=00000000-0000-0000-0000-000000000000
WORKER_DEVICE_TOKEN=replace-with-the-one-time-issued-device-token
WORKER_RUNTIME_ROOT=runtime
WORKER_RUNTIME_STATUS_PATH=runtime-status.json
WORKER_LOG_DIRECTORY=logs
WORKER_LOG_MAX_BYTES=5242880
WORKER_LOG_BACKUP_COUNT=5
WORKER_YINGDAO_INSTALL_ROOT=D:\path\to\ShadowBot
# Optional. Defaults to %LOCALAPPDATA%\ShadowBot on Windows.
# WORKER_YINGDAO_DATA_ROOT=C:\Users\CurrentUser\AppData\Local\ShadowBot
# Optional and safety-gated. Only configure an App UUID that is explicitly
# confirmed to have no external side effects.
# WORKER_YINGDAO_TEST_APP_ID=00000000-0000-0000-0000-000000000000
