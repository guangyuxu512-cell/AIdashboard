# Dedicated development database. Never commit real credentials.
BACKEND_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/control_center_dev
BACKEND_ENCRYPTION_KEY=<generated-fernet-key>
BACKEND_RUNTIME_ENVIRONMENT=development
# JSON array. Same-origin deployments should keep this empty.
BACKEND_CORS_ALLOWED_ORIGINS=[]
BACKEND_HUMAN_SESSION_TTL_SECONDS=604800
BACKEND_HUMAN_SESSION_COOKIE_NAME=siyu_human_session
# Development localhost HTTP may use false. Production must use true.
BACKEND_HUMAN_SESSION_COOKIE_SECURE=false
BACKEND_HUMAN_SESSION_COOKIE_SAMESITE=lax
BACKEND_HUMAN_SESSION_COOKIE_PATH=/api/v1
BACKEND_ASSET_STORAGE_DIR=data/assets
BACKEND_ASSET_MAX_UPLOAD_BYTES=10485760
BACKEND_WORKER_ONLINE_TIMEOUT_SECONDS=45
BACKEND_WORKER_TASK_LEASE_SECONDS=60
BACKEND_WORKER_RECONCILE_INTERVAL_SECONDS=10
BACKEND_TASK_EVENT_RETENTION_DAYS=90
BACKEND_TASK_EVENT_RETENTION_SWEEP_INTERVAL_SECONDS=86400
BACKEND_TASK_EVENT_RETENTION_BATCH_SIZE=100
BACKEND_SHOP_SESSION_VALIDATION_FRESHNESS_SECONDS=300
BACKEND_SHOP_SESSION_REFRESH_LEASE_SECONDS=1800
