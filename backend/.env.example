# Dedicated development database. Never commit real credentials.
BACKEND_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/control_center_dev
BACKEND_ENCRYPTION_KEY=<generated-fernet-key>
BACKEND_RUNTIME_ENVIRONMENT=development
# JSON array. Same-origin deployments should keep this empty.
BACKEND_CORS_ALLOWED_ORIGINS=[]
BACKEND_HUMAN_SESSION_TTL_SECONDS=604800
BACKEND_HUMAN_SESSION_COOKIE_NAME=siyu_human_session
# Development localhost HTTP may use false. Production must use true.
BACKEND_HUMAN_SESSION_COOKIE_SECURE=false
BACKEND_HUMAN_SESSION_COOKIE_SAMESITE=lax
BACKEND_HUMAN_SESSION_COOKIE_PATH=/api/v1
# local is the existing directory/named-volume behavior. mounted requires a
# pre-mounted and marker-verified directory; see backend/docs/12-资产与存储架构.md.
BACKEND_ASSET_STORAGE_MODE=local
BACKEND_ASSET_STORAGE_DIR=data/assets
BACKEND_ASSET_MAX_UPLOAD_BYTES=10485760
BACKEND_WORKER_ONLINE_TIMEOUT_SECONDS=45
BACKEND_WORKER_TASK_LEASE_SECONDS=60
BACKEND_WORKER_RECONCILE_INTERVAL_SECONDS=10
BACKEND_TASK_EVENT_RETENTION_DAYS=90
BACKEND_TASK_EVENT_RETENTION_SWEEP_INTERVAL_SECONDS=86400
BACKEND_TASK_EVENT_RETENTION_BATCH_SIZE=100
BACKEND_SHOP_SESSION_VALIDATION_FRESHNESS_SECONDS=300
BACKEND_SHOP_SESSION_REFRESH_LEASE_SECONDS=1800
BACKEND_AI_GENERATION_SCAN_INTERVAL_SECONDS=1
BACKEND_AI_GENERATION_CONCURRENCY=5
# ToAPIs is optional until real AI execution is enabled for this deployment.
BACKEND_TOAPIS_API_KEY=<toapis-api-key>
BACKEND_TOAPIS_BASE_URL=https://toapis.cn
BACKEND_TOAPIS_RESOLUTION=2k
BACKEND_TOAPIS_QUALITY=low
BACKEND_TOAPIS_POLL_INTERVAL_SECONDS=5
BACKEND_TOAPIS_POLL_TIMEOUT_SECONDS=180
BACKEND_TOAPIS_REQUEST_TIMEOUT_SECONDS=180
# Internal-only Douyin signer. The API key is required before enabling its service.
BACKEND_DOUYIN_SIGNER_URL=http://127.0.0.1:8787
BACKEND_DOUYIN_SIGNER_API_KEY=<generated-internal-signer-key>
BACKEND_DOUYIN_SIGNER_TIMEOUT_SECONDS=15
# Explicit read-only collection execution only; no automatic scheduler is
# enabled by this setting.
BACKEND_DOUYIN_COMPASS_COLLECTION_CONCURRENCY=5
# Automatic operating-data work is opt-in.  Keep both switches false for
# development/integration; production enables them only after the deployed
# queue and Session scope have been checked.
BACKEND_OPERATING_DASHBOARD_COLLECTION_EXECUTION_ENABLED=false
BACKEND_OPERATING_DASHBOARD_DAILY_COLLECTION_ENABLED=false
BACKEND_OPERATING_DASHBOARD_DAILY_COLLECTION_LOCAL_TIME=09:00:00
BACKEND_OPERATING_DASHBOARD_COLLECTION_SCAN_INTERVAL_SECONDS=5
BACKEND_OPERATING_DASHBOARD_COLLECTION_LEASE_SECONDS=120
BACKEND_OPERATING_DASHBOARD_COLLECTION_MAX_ATTEMPTS=3
BACKEND_OPERATING_DASHBOARD_COLLECTION_RETRY_BASE_SECONDS=30
BACKEND_OPERATING_DASHBOARD_GAP_RECOVERY_RETRY_COOLDOWN_SECONDS=86400
# Recovery shares COLLECTION_MAX_ATTEMPTS across a Shop/date failure chain.
# First history is selected manually; daily planning collects yesterday only.
# Signer pre-warms one-shot isolated Node children; it must not be tied to
# collection concurrency because the signer container has its own CPU budget.
DOUYIN_SIGNER_WARM_POOL_SIZE=2
DOUYIN_SIGNER_QUEUE_TIMEOUT_MS=15000
