{
  "name": "@control-center/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_API_MODE=mock vite --host 127.0.0.1 --mode mock",
    "dev:real": "cross-env VITE_API_MODE=real vite --host 127.0.0.1 --mode real",
    "build": "pnpm run typecheck && cross-env VITE_API_MODE=real vite build --mode production",
    "build:visual-mock": "pnpm run typecheck && cross-env VITE_API_MODE=mock vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "cross-env PLAYWRIGHT_API_MODE=mock playwright test --project=mock --project=visual",
    "test:e2e:mock": "cross-env PLAYWRIGHT_API_MODE=mock playwright test --project=mock",
    "test:e2e:real": "cross-env PLAYWRIGHT_API_MODE=real playwright test --project=real",
    "test:e2e:visual": "cross-env PLAYWRIGHT_API_MODE=mock playwright test --project=visual"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@tanstack/vue-query": "^5.66.8",
    "@vueuse/core": "^12.7.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.1",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^20.17.19",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
