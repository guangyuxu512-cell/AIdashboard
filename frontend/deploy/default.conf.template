server {
    listen ${FRONTEND_BIND_HOST}:${FRONTEND_BIND_PORT};
    server_name _;

    # Match the host proxy and leave multipart overhead above the 10 MiB file limit.
    client_max_body_size 12m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Keep the sensitive signing request streaming even if this inner proxy is
    # accessed directly; authentication remains the Backend's responsibility.
    location ~ "^/api/v1/worker/tasks/[^/]+/precheck-sign/?$" {
        access_log off;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /internal/mobile-collection/v1/ {
        return 404;
    }

    # The former mobile web UI and central collection endpoint have retired.
    location = /mobile { return 404; }
    location ^~ /mobile/ { return 404; }

    location = /token-manager {
        absolute_redirect off;
        return 302 "/token-admin/#centre";
    }

    location ^~ /token-manager/ {
        absolute_redirect off;
        return 302 "/token-admin/#centre";
    }

    location = /token-admin {
        absolute_redirect off;
        return 308 /token-admin/;
    }

    # Only Token administration and scope lookup are forwarded. The caller's
    # Bearer is never replaced with a service credential; cookies are stripped.
    # Resolve lazily so a temporary DNS outage cannot prevent Nginx starting.
    location ^~ /token-admin/_product/ {
        if ($uri !~ "^/token-admin/_product/api/v1/(tokens(/permissions|/[0-9a-f]{32}(/reveal)?)?|product-groups)$") { return 404; }
        set $token_admin_product_host pdc.mysiyuai.top;
        rewrite ^/token-admin/_product(/api/v1/.*)$ $1 break;
        resolver 127.0.0.53 valid=300s ipv6=off;
        proxy_pass https://$token_admin_product_host$uri$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name pdc.mysiyuai.top;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 5;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host pdc.mysiyuai.top;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        access_log off;
    }

    location ^~ /token-admin/_collector/ {
        if ($uri !~ "^/token-admin/_collector/collector-api/v1/admin/browsers(/[0-9a-f]{32}/submit-token(/reveal|/permissions)?)?$") { return 404; }
        rewrite ^/token-admin/_collector(/collector-api/.*)$ $1 break;
        # The collector relay is bound to loopback on the same production host.
        proxy_pass http://127.0.0.1:18327$uri$is_args$args;
        proxy_set_header Host pdc.mysiyuai.top;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        access_log off;
    }

    location ^~ /token-admin/_operations/ {
        if ($uri !~ "^/token-admin/_operations/api/v1/(tokens(/permissions|/[0-9a-f]{32}(/reveal)?)?|product-groups|sourcing/worker/overview)$") { return 404; }
        rewrite ^/token-admin/_operations(/api/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:18521$uri$is_args$args;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        access_log off;
    }

    location = /operations {
        absolute_redirect off;
        return 308 /operations/;
    }

    # Stream signed 1688 release archives without buffering them in the gateway.
    location ^~ /operations/api/v1/sourcing/worker/releases/ {
        rewrite ^/operations(/api/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:18521$uri$is_args$args;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        access_log off;
    }

    # The independent service keeps its own authentication and data.
    location ^~ /operations/api/v1/ {
        rewrite ^/operations(/api/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:18521$uri$is_args$args;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        access_log off;
    }

    location ^~ /operations/internal/worker/v1/ {
        rewrite ^/operations(/internal/worker/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:18521$uri$is_args$args;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        access_log off;
    }

    location ^~ /operations/ {
        root /var/lib/control-center-static;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        location ~* \.(?:js|mjs|css)$ { try_files $uri =404; }
        try_files $uri $uri/ /operations/index.html;
    }

    # Deployed separately from the private Token-Manager-Web release artifact.
    location ^~ /token-admin/ {
        root /var/lib/control-center-static;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri @retained_pc_asset;
    }

    location @retained_pc_asset {
        root /var/lib/control-center-static;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css)$ {
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }
}
