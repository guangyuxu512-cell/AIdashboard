server {
    listen ${FRONTEND_BIND_HOST}:${FRONTEND_BIND_PORT};
    server_name _;

    # Match the host proxy and leave multipart overhead above the 10 MiB file limit.
    client_max_body_size 12m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Keep the sensitive signing request streaming even if this inner proxy is
    # accessed directly; authentication remains the Backend's responsibility.
    location ~ "^/api/v1/worker/tasks/[^/]+/precheck-sign/?$" {
        access_log off;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /internal/mobile-collection/v1/ {
        return 404;
    }

    # The former mobile web UI and central collection endpoint have retired.
    location = /mobile { return 404; }
    location ^~ /mobile/ { return 404; }

    location = /token-manager {
        absolute_redirect off;
        return 308 /token-manager/;
    }

    location ^~ /token-manager/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri @retained_pc_asset;
    }

    location @retained_pc_asset {
        root /var/lib/control-center-static;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css)$ {
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }
}
