# This file is an example only. Copy it to the server at
# /opt/ecommerce-control-center/production/.env with mode 0600. Never commit it.

# Independent production database and its least-privilege application role.
BACKEND_DATABASE_URL=postgresql+psycopg://control_center_prod_app:<password>@127.0.0.1:35433/control_center_prod
BACKEND_ENCRYPTION_KEY=<generated-fernet-key>
BACKEND_RUNTIME_ENVIRONMENT=production
BACKEND_CORS_ALLOWED_ORIGINS=[]
BACKEND_HUMAN_SESSION_TTL_SECONDS=604800
BACKEND_HUMAN_SESSION_COOKIE_NAME=siyu_human_session
BACKEND_HUMAN_SESSION_COOKIE_SECURE=true
BACKEND_HUMAN_SESSION_COOKIE_SAMESITE=lax
BACKEND_HUMAN_SESSION_COOKIE_PATH=/api/v1

# Same-host isolated production ports. Do not publish these Docker services directly.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_BIND_PORT=18001
DOUYIN_SIGNER_BIND_PORT=8788
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_PORT=18080
VITE_API_BASE_URL=/
BACKEND_DOUYIN_SIGNER_URL=http://127.0.0.1:8788
BACKEND_DOUYIN_SIGNER_API_KEY=<generated-internal-signer-key>
BACKEND_DOUYIN_SIGNER_TIMEOUT_SECONDS=15
BACKEND_DOUYIN_COMPASS_COLLECTION_CONCURRENCY=5
# Signer process pre-warm pool. It is deliberately smaller than collection
# concurrency because each signing child is single-use and isolated.
DOUYIN_SIGNER_WARM_POOL_SIZE=2
DOUYIN_SIGNER_QUEUE_TIMEOUT_MS=15000

BACKEND_ASSET_STORAGE_DIR=/app/data/assets
# local keeps the existing Docker named volume. mounted requires the host path
# in BACKEND_ASSET_STORAGE_VOLUME_SOURCE to be mounted and marker-verified.
BACKEND_ASSET_STORAGE_MODE=local
BACKEND_ASSET_MAX_UPLOAD_BYTES=10485760
BACKEND_WORKER_ONLINE_TIMEOUT_SECONDS=45
BACKEND_WORKER_TASK_LEASE_SECONDS=60
BACKEND_WORKER_RECONCILE_INTERVAL_SECONDS=10
BACKEND_TASK_EVENT_RETENTION_DAYS=90
BACKEND_TASK_EVENT_RETENTION_SWEEP_INTERVAL_SECONDS=86400
BACKEND_TASK_EVENT_RETENTION_BATCH_SIZE=100
BACKEND_SHOP_SESSION_VALIDATION_FRESHNESS_SECONDS=300
BACKEND_SHOP_SESSION_REFRESH_LEASE_SECONDS=1800

# Required when real AI generation is enabled in production.
BACKEND_TOAPIS_API_KEY=<toapis-api-key>
BACKEND_TOAPIS_BASE_URL=https://toapis.cn
BACKEND_TOAPIS_RESOLUTION=2k
BACKEND_TOAPIS_QUALITY=low
BACKEND_TOAPIS_POLL_INTERVAL_SECONDS=5
BACKEND_TOAPIS_POLL_TIMEOUT_SECONDS=180
BACKEND_TOAPIS_REQUEST_TIMEOUT_SECONDS=180

# Public-IP HTTPS uses a six-day Let's Encrypt IP certificate. The value keeps
# the existing PRODUCTION_DOMAIN name because Nginx accepts an IP server_name.
# It must be the real public IPv4 address, not a private/loopback address.
PRODUCTION_DOMAIN=<public-ipv4>
PRODUCTION_ACME_EMAIL=<acme-account-contact-email>
PRODUCTION_ACME_CERT_NAME=control-center-production-ip
PRODUCTION_ACME_CERTBOT_IMAGE=certbot/certbot:v5.8.0
PRODUCTION_ACME_STATE_DIR=/opt/ecommerce-control-center/production/acme/etc
PRODUCTION_ACME_WEBROOT_DIR=/var/lib/control-center-production-acme
PRODUCTION_TLS_CERTIFICATE_PATH=/opt/ecommerce-control-center/production/acme/etc/live/control-center-production-ip/fullchain.pem
PRODUCTION_TLS_CERTIFICATE_KEY_PATH=/opt/ecommerce-control-center/production/acme/etc/live/control-center-production-ip/privkey.pem
PRODUCTION_NGINX_VHOST_DIR=/www/server/panel/vhost/nginx
