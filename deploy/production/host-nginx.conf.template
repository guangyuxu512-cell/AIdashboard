server {
    listen 80;
    server_name ${PRODUCTION_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root ${PRODUCTION_ACME_WEBROOT_DIR};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${PRODUCTION_DOMAIN};

    ssl_certificate ${PRODUCTION_TLS_CERTIFICATE_PATH};
    ssl_certificate_key ${PRODUCTION_TLS_CERTIFICATE_KEY_PATH};

    client_max_body_size 12m;

    # Worker provisioning first checks this public, unauthenticated Backend contract.
    # Do not let the Frontend SPA fallback turn it into HTML.
    location = /health {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # External applications connect directly to the backend over this TLS
    # endpoint.  The SPA proxy overwrites the scheme and cannot serve it.
    location ^~ /internal/applications/v1/ {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ProductDataCenter owns these files on NAS.  Expose only its immutable
    # image-download prefix; the adjacent RPA and management APIs stay private.
    location ^~ /rpa/v1/product-images/ {
        limit_except GET {
            deny all;
        }
        proxy_pass ${PRODUCT_LIBRARY_IMAGE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
