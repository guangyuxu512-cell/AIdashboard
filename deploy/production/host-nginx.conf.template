server {
    listen 80;
    server_name ${PRODUCTION_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root ${PRODUCTION_ACME_WEBROOT_DIR};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${PRODUCTION_DOMAIN};

    ssl_certificate ${PRODUCTION_TLS_CERTIFICATE_PATH};
    ssl_certificate_key ${PRODUCTION_TLS_CERTIFICATE_KEY_PATH};

    client_max_body_size 12m;

    # Worker provisioning first checks this public, unauthenticated Backend contract.
    # Do not let the Frontend SPA fallback turn it into HTML.
    location = /health {
        proxy_pass http://127.0.0.1:${BACKEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_BIND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
